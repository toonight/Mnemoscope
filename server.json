{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.toonight/mnemoscope",
  "title": "Mnemoscope",
  "description": "Predict context rot, sign every agent write, tier reads. Markdown-native, 100% local.",
  "websiteUrl": "https://github.com/toonight/Mnemoscope",
  "repository": {
    "url": "https://github.com/toonight/Mnemoscope",
    "source": "github",
    "subfolder": "packages/mcp-server"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@mnemoscope/mcp-server",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "categories": ["memory", "developer-tools", "knowledge-management"],
      "tags": [
        "memory",
        "obsidian",
        "markdown",
        "claude-code",
        "forensics",
        "rot-detection",
        "tiered-memory",
        "ed25519",
        "opentimestamps"
      ]
    }
  }
}
