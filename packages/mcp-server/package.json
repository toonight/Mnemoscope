{
  "name": "@mnemoscope/mcp-server",
  "version": "0.2.0",
  "mcpName": "io.github.toonight/mnemoscope",
  "description": "MCP server exposing Mnemoscope's predict_rot, get_tiered_read, and journal tools to any MCP-compatible client.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/toonight/Mnemoscope#readme",
  "bugs": {
    "url": "https://github.com/toonight/Mnemoscope/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toonight/Mnemoscope.git",
    "directory": "packages/mcp-server"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mnemoscope-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mnemoscope/core": "0.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
