{
  "name": "@mnemoscope/cli",
  "version": "0.1.0",
  "description": "Mnemoscope command-line entrypoints, including the Claude Code PostToolUse hook that auto-journals Write/Edit/MultiEdit operations.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mnemoscope-init": "dist/init.js",
    "mnemoscope-record-hook": "dist/record-hook.js",
    "mnemoscope-verify": "dist/verify.js",
    "mnemoscope-backup-key": "dist/backup-key.js",
    "mnemoscope-restore-key": "dist/restore-key.js",
    "mnemoscope-timestamp": "dist/timestamp.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mnemoscope/core": "0.1.0"
  }
}
