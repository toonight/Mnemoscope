{
  "name": "@mnemoscope/core",
  "version": "0.2.0",
  "description": "Core memory observability primitives for Mnemoscope: rot scoring, tiering, signed journal.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
